@model ArtistForm
@{
    ViewData["Title"] = !Model.Id.HasValue ? "Add an artist" : "Edit artist";
}
<section class="shell content-page">
    <a class="back-link" asp-action="Index">Artists</a>
    <div class="form-panel">
        <h1>@ViewData["Title"]</h1>
        <form asp-action="Create" method="post" class="edit-form">
            <input asp-for="Id" type="hidden">
            <input asp-for="Version" type="hidden">
            <div asp-validation-summary="All" class="validation"></div>
            <div><label asp-for="Name"></label><input asp-for="Name" maxlength="200" required></div>
            <div class="actions">
                <button class="button button-accent">Save artist</button>
                <a class="button" asp-action="Index">Cancel</a>
                @if (Model.Id.HasValue)
                {
                    <a class="button button-danger" asp-action="Delete" asp-route-id="@Model.Id">Remove artist</a>
                }
            </div>
        </form>
    </div>
</section>
