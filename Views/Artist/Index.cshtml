@model ArtistsView
@{
    ViewData["Title"] = "Artists";
    var isOwner = User.Identity?.IsAuthenticated == true;
}
<section class="shell content-page">
    <div class="section-head">
        <h1>Artists</h1>
        @if (isOwner)
        {
            <a class="button button-accent" asp-action="Add">Add an artist</a>
        }
    </div>
    <form class="artist-search" asp-action="Index" method="get">
        <div><label for="artist-search">Search artists</label><input type="search" name="search" id="artist-search" value="@Model.Search" maxlength="200"></div>
        <button class="button button-solid">Search</button>
    </form>
    <div class="results-info">
        <p>@Model.Artists.Count @(Model.Artists.Count == 1 ? "artist" : "artists")</p>
        @if (!string.IsNullOrWhiteSpace(Model.Search))
        {
            <a asp-action="Index">Clear search</a>
        }
    </div>
    @if (Model.Artists.Count == 0)
    {
        <div class="empty"><h2>No artists found</h2></div>
    }
    else
    {
        <ul class="artist-list">
            @foreach (var artist in Model.Artists)
            {
                <li>
                    <div>
                        <h2><a asp-controller="Home" asp-action="Index" asp-route-artistId="@artist.Id" asp-fragment="collection">@artist.Name</a></h2>
                        <p>@artist.RecordCount @(artist.RecordCount == 1 ? "record" : "records")</p>
                    </div>
                    @if (isOwner)
                    {
                        <a class="button" aria-label="Edit @artist.Name" asp-action="Edit" asp-route-id="@artist.Id">Edit</a>
                    }
                </li>
            }
        </ul>
    }
</section>
