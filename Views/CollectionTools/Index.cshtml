@model SleeveQueue
@{
    ViewData["Title"] = "Manage the collection";
}
<section class="shell content-page">
    <div class="section-head">
        <h1>Manage the collection</h1>
        <div class="actions">
            <a class="button button-accent" asp-controller="Album" asp-action="Add">Add a record</a>
            <a class="button" asp-action="Export">Export CSV</a>
            @if (!CollectionSession.IsPersonal(User))
            {
                <a class="button" asp-controller="Recovery" asp-action="Manage">Account recovery</a>
            }
            else
            {
                <a class="button" asp-controller="AccountEmail" asp-action="Index">Account settings</a>
                <a class="button" asp-controller="Sharing" asp-action="Settings">Share collection</a>
            }
        </div>
    </div>
    <form asp-action="Index" method="get" class="filter-bar review-filters">
        <div><label for="queue">Queue</label>
            <select id="queue" name="queue">
                <option value="review" selected="@(Model.Queue == "review")">Pressing review (@Model.PendingReviews)</option>
                <option value="estimated" selected="@(Model.Queue == "estimated")">Estimated pressings (@Model.Estimated)</option>
                <option value="cover" selected="@(Model.Queue == "cover")">Missing cover art (@Model.MissingCovers)</option>
                <option value="format" selected="@(Model.Queue == "format")">Missing vinyl details (@Model.MissingFormats)</option>
                <option value="size" selected="@(Model.Queue == "size")">Missing vinyl size (@Model.MissingSizes)</option>
                <option value="all" selected="@(Model.Queue == "all")">All records</option>
            </select>
        </div>
        <div><label for="queue-search">Search this queue</label><input name="search" id="queue-search" type="search" value="@Model.Search" maxlength="200"></div>
        <button type="submit" class="button button-solid">Apply</button>
    </form>
    <div class="results-info"><p>@Model.Matches @(Model.Matches == 1 ? "record" : "records")</p></div>
    @if (Model.Items.Count == 0)
    {
        <div class="empty"><h2>No matching records</h2></div>
    }
    else
    {
        <ul class="artist-list review-list">
            @foreach (var record in Model.Items)
            {
                var missing = CatalogValidation.MissingPressingDetails(record).ToArray();
                <li>
                    <div class="review-item">
                        <h3><a asp-controller="Album" asp-action="Details" asp-route-id="@record.Id">@record.Name</a></h3>
                        <p>@record.DisplayArtist · @record.Medium @if (record.CatalogNumber is not null) { <span> · @record.CatalogNumber</span> } @if (RecordMedia.HasDetails(record.Medium, record.Format)) { <span> · @record.Format</span> }</p>
                        <p>@(record.PressingReviewed ? "Pressing reviewed" : record.PressingEstimated ? "Estimated pressing" : missing.Length > 0 ? "Review pending" : "Pressing details complete") @if (!record.HasCover) { <span> · Cover missing</span> }</p>
                        @if (missing.Length > 0)
                        {
                            <p class="review-missing"><strong>Missing</strong> @string.Join(", ", missing)</p>
                        }
                        <div class="review-actions">
                            <a class="button" asp-controller="Album" asp-action="Edit" asp-route-id="@record.Id" asp-route-lookup="Barcode"
                               asp-fragment="pressing-lookup-title" aria-label="Scan barcode for @record.Name">Scan barcode</a>
                            <a class="button" asp-controller="Album" asp-action="Edit" asp-route-id="@record.Id" asp-route-lookup="Catalogue"
                               asp-fragment="pressing-lookup-title" aria-label="Look up catalogue number for @record.Name">Look up catalogue number</a>
                            @if (record.Medium == RecordMedium.Vinyl && !VinylSizing.HasSize(record.Format))
                            {
                                <a class="button" asp-controller="Sleeve" asp-action="Edit" asp-route-id="@record.Id"
                                   asp-fragment="vinyl-size" aria-label="Set vinyl size for @record.Name">Set vinyl size</a>
                            }
                            <a class="quiet-link" asp-controller="Sleeve" asp-action="Edit" asp-route-id="@record.Id" aria-label="Review sleeves and pressing for @record.Name">Sleeves and review</a>
                        </div>
                    </div>
                </li>
            }
        </ul>
    }
    @if (Model.Pages > 1)
    {
        <nav class="pagination" aria-label="Review queue pages">
            @if (Model.Page > 1)
            {
                <a class="button" asp-action="Index" asp-route-queue="@Model.Queue" asp-route-search="@Model.Search" asp-route-page="@(Model.Page - 1)">Previous</a>
            }
            <span>Page @Model.Page of @Model.Pages</span>
            @if (Model.Page < Model.Pages)
            {
                <a class="button" asp-action="Index" asp-route-queue="@Model.Queue" asp-route-search="@Model.Search" asp-route-page="@(Model.Page + 1)">Next</a>
            }
        </nav>
    }
</section>
