@model ErrorViewModel
@{
    ViewData["Title"] = "Something went wrong";
}
<section class="shell content-page">
    <div class="form-panel">
        <h1>Something went wrong</h1>
        <p>Try opening the collection again in a moment.</p>
        <a class="button button-accent" asp-controller="Home" asp-action="Index">Back to the collection</a>
        @if (Model.ShowRequestId)
        {
            <p class="field-hint">Request ID <code>@Model.RequestId</code></p>
        }
    </div>
</section>
