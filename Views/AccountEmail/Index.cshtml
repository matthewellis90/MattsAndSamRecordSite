@model AccountEmailForm
@{
    ViewData["Title"] = "Account settings";
}
<section class="shell content-page">
    <div class="form-panel form-narrow">
        <h1>Account settings</h1>
        <h2>Recovery email</h2>
        @if (Model.Verified is { } address)
        {
            <p>Verified address <strong>@address</strong></p>
        }
        @if (Model.Pending is { } pending)
        {
            <p>Awaiting verification <strong>@pending</strong></p>
        }
        @if (Model.MailConfigured)
        {
            <form asp-action="Index" method="post" class="edit-form">
                <div asp-validation-summary="All" class="validation"></div>
                <div><label asp-for="Address"></label><input asp-for="Address" type="email" autocomplete="email" maxlength="254" required></div>
                <div><label asp-for="Password"></label><input asp-for="Password" autocomplete="current-password" maxlength="256" required></div>
                <button class="button button-accent" type="submit">Send verification email</button>
            </form>
        }
        else
        {
            <p>Email delivery is awaiting setup by the site owner.</p>
        }
    </div>
</section>
