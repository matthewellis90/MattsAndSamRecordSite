@model Album
@{
    ViewData["Title"] = Model.Name;
}
<section class="shell content-page">
    <a class="back-link" asp-controller="Home" asp-action="Index" asp-fragment="collection">Collection</a>
    <article class="record-detail">
        <div class="detail-intro">
            <p class="eyebrow">@Model.Kind · @Model.Medium</p>
            <h1>@Model.Name</h1>
            @if (Model.ArtistId is int artistId)
            {
                <p class="detail-artist"><a asp-controller="Home" asp-action="Index" asp-route-artistId="@artistId" asp-fragment="collection">@Model.DisplayArtist</a></p>
            }
            else
            {
                <p class="detail-artist">@Model.DisplayArtist</p>
            }
            <partial name="_Spotify" model="Model" />
        </div>
        <partial name="_RecordSleeves" model="Model" />
        <div class="detail-copy">
            <partial name="_PressingDetails" model="Model" />
            @if (!string.IsNullOrWhiteSpace(Model.Notes))
            {
                <h2>Notes</h2>
                <p class="notes">@Model.Notes</p>
            }
            @if (User.Identity?.IsAuthenticated == true)
            {
                <div class="actions">
                    <a class="button button-accent" asp-action="Edit" asp-route-id="@Model.Id">Edit record</a>
                    <a class="button" asp-controller="Sleeve" asp-action="Edit" asp-route-id="@Model.Id">Sleeves and review</a>
                    <a class="button button-danger" asp-action="Delete" asp-route-id="@Model.Id">Remove record</a>
                </div>
            }
        </div>
    </article>
</section>
